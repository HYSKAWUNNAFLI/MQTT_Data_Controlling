{
  "App": {
    "Name": "mqttpetproject",
    "StoreDlqAudit": true
  },
  "RabbitMq": {
    "Exchanges": [
      {
        "Name": "amq.topic",
        "Type": "topic",
        "Durable": true,
        "Declare": false
      },
      {
        "Name": "factory.electricity.exchange",
        "Type": "topic",
        "Durable": true
      },
      {
        "Name": "factory.steam.exchange",
        "Type": "topic",
        "Durable": true
      },
      {
        "Name": "factory.gas.exchange",
        "Type": "topic",
        "Durable": true
      },
      {
        "Name": "factory.data.dlx",
        "Type": "direct",
        "Durable": true
      }
    ],
    "ExchangeBindings": [
      {
        "SourceExchange": "amq.topic",
        "DestinationExchange": "factory.electricity.exchange",
        "RoutingKey": "factory.telemetry.electricity.#"
      },
      {
        "SourceExchange": "amq.topic",
        "DestinationExchange": "factory.steam.exchange",
        "RoutingKey": "factory.telemetry.steam.#"
      },
      {
        "SourceExchange": "amq.topic",
        "DestinationExchange": "factory.gas.exchange",
        "RoutingKey": "factory.telemetry.gas.#"
      }
    ],
    "Queues": [
      {
        "Name": "factory.telemetry.electricity.queue",
        "PrefetchCount": 1,
        "ConsumerCount": 2,
        "MaxRetryAttempts": 3,
        "DeadLetterExchange": "factory.data.dlx",
        "DeadLetterRoutingKey": "factory.telemetry.dlq",
        "Bindings": [
          {
            "Exchange": "factory.electricity.exchange",
            "RoutingKey": "factory.telemetry.electricity.#"
          }
        ]
      },
      {
        "Name": "factory.telemetry.steam.queue",
        "PrefetchCount": 1,
        "ConsumerCount": 2,
        "MaxRetryAttempts": 3,
        "DeadLetterExchange": "factory.data.dlx",
        "DeadLetterRoutingKey": "factory.telemetry.dlq",
        "Bindings": [
          {
            "Exchange": "factory.steam.exchange",
            "RoutingKey": "factory.telemetry.steam.#"
          }
        ]
      },
      {
        "Name": "factory.telemetry.gas.queue",
        "PrefetchCount": 1,
        "ConsumerCount": 2,
        "MaxRetryAttempts": 3,
        "DeadLetterExchange": "factory.data.dlx",
        "DeadLetterRoutingKey": "factory.telemetry.dlq",
        "Bindings": [
          {
            "Exchange": "factory.gas.exchange",
            "RoutingKey": "factory.telemetry.gas.#"
          }
        ]
      },
      {
        "Name": "factory.data.dlq",
        "ConsumerCount": 0,
        "Bindings": [
          {
            "Exchange": "factory.data.dlx",
            "RoutingKey": "factory.telemetry.dlq"
          }
        ]
      }
    ]
  },
  "MongoDb": {
    "ConnectionString": "mongodb://127.0.0.1:27017",
    "DatabaseName": "smartfactory",
    "TelemetryCollection": "telemetry_raw",
    "DlqCollection": "telemetry_dlq_audit"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "mqttpetproject": "Debug"
    }
  }
}
